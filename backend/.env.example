# Server
PORT=3000

# Supabase (project settings)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres: use Supabase "Connection string" (URI), often port 5432 with sslmode=require
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.your-project.supabase.co:5432/postgres
DATABASE_SSL=

# Optional: disable SSL for local Postgres only
# DATABASE_SSL=false

# Legacy local DB (used if DATABASE_URL is unset)
DB_HOST=localhost
DB_PORT=5432
DB_USER=user
DB_PASSWORD=password
DB_NAME=skillmesh

# Redis (unchanged)
REDIS_URL=redis://localhost:6379

# One-off migration script (scripts/migrate-to-supabase.js)
SOURCE_DATABASE_URL=postgresql://user:password@localhost:5432/skillmesh
TARGET_DATABASE_URL=
